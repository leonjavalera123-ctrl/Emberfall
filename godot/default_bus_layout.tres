[gd_resource type="AudioBusLayout" format=3]

; EMBERFALL: 1940 — the mixer.
;
; Three buses, because the settings screen needs exactly three faders. Music
; and SFX both send to Master, so the Master slider rides everything and the
; other two trim within it.
;
; Bus level is the ONLY thing settings touches. Every player still sets its own
; volume_db for per-sound mixing (the war layer's combat swell, the anthem duck,
; a quiet UI chime) and those two controls are orthogonal by design: bus volume
; is what the player asked for, volume_db is what the mix asked for.

[resource]
bus/0/name = &"Master"
bus/0/solo = false
bus/0/mute = false
bus/0/bypass_fx = false
bus/0/volume_db = 0.0
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
